# Токен бота от @BotFather
BOT_TOKEN=

# Публичный адрес Mini App (https обязателен для Telegram)
APP_URL=https://azkar.nurtech.dev/app/

# Порт статик-сервера (за nginx)
PORT=3010

# Часовой пояс и расписание напоминаний (cron)
TZ=Europe/Moscow
MORNING_CRON=30 6 * * *
EVENING_CRON=0 18 * * *
SLEEP_CRON=30 22 * * *
